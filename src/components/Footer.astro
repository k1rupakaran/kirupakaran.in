---
import { GLOBAL } from "../lib/config";
---

<footer class="mt-auto py-6 md:py-10 border-t xq-border xq-transition">
    <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
            <p class="xq-text xq-transition text-base md:text-lg font-light tracking-wider">
                &copy; {new Date().getFullYear()}
                <span class="font-semibold">{GLOBAL.name}</span>
            </p>

            <div class="flex items-center space-x-6">
                <a
                    href={GLOBAL.social.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="xq-text xq-transition hover:xq-accent text-sm md:text-base"
                    aria-label="GitHub"
                    title="GitHub"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
                </a>
                <a
                    href={GLOBAL.social.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="xq-text xq-transition hover:xq-accent text-sm md:text-base"
                    aria-label="LinkedIn"
                    title="LinkedIn"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                </a>
                <a
                    href={"mailto:" + GLOBAL.social.email}
                    class="xq-text xq-transition hover:xq-accent text-sm md:text-base"
                    aria-label="Email"
                    title="Email"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                </a>
                <a
                    href={GLOBAL.social.peerlist}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="xq-text xq-transition hover:xq-accent text-sm md:text-base"
                    aria-label="Peerlist"
                    title="Peerlist"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="10" r="3"></circle><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662"></path></svg>
                </a>
            </div>
        </div>
    </div>
</footer>
