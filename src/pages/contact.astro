---
import Layout from "../layouts/Layout.astro";
import { GLOBAL } from "../lib/config";
---

<Layout
  title="Get In Touch"
  description="Connect with Manikandan B, Full Stack Engineer. Currently employed at Sirine.ai B.V but open to technology discussions and networking. Reach out via email, LinkedIn, or GitHub."
  keywords="Contact Manikandan B, Full Stack Engineer Contact, Software Engineer Chennai, Networking, Technology Discussions, Email Contact, LinkedIn Profile, GitHub Profile, Developer Community"
>
  <section class="w-full py-10 space-y-8">
    <div>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-wider mb-4">Get In Touch</h1>
      <p class="text-lg md:text-xl xq-accent-muted leading-relaxed">
        Let's discuss opportunities, collaboration, or just have a chat about tech
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="space-y-6">
        <div>
          <h2 class="text-xl md:text-2xl font-semibold mb-4">Reach Out</h2>
          <p class="text-base md:text-lg leading-relaxed mb-6 text-gray-600 dark:text-gray-400">
            I enjoy connecting with fellow developers, discussing innovative projects,
            and sharing knowledge about technology. Feel free to reach out through any of these channels.
          </p>
        </div>

        <div class="space-y-4">
          <a
            href={`mailto:${GLOBAL.social.email}`}
            class="flex items-center p-4 border xq-border rounded-lg xq-transition hover:shadow-lg group"
          >
            <div class="w-12 h-12 rounded-lg bg-blue-500/10 flex items-center justify-center mr-4 group-hover:bg-blue-500/20 xq-transition">
              <svg class="w-6 h-6 xq-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold">Email</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">{GLOBAL.social.email}</p>
            </div>
          </a>

          <a
            href={GLOBAL.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center p-4 border xq-border rounded-lg xq-transition hover:shadow-lg group"
          >
            <div class="w-12 h-12 rounded-lg bg-blue-500/10 flex items-center justify-center mr-4 group-hover:bg-blue-500/20 xq-transition">
              <svg class="w-6 h-6 xq-accent" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold">LinkedIn</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">Professional network</p>
            </div>
          </a>

          <a
            href={GLOBAL.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center p-4 border xq-border rounded-lg xq-transition hover:shadow-lg group"
          >
            <div class="w-12 h-12 rounded-lg bg-gray-500/10 flex items-center justify-center mr-4 group-hover:bg-gray-500/20 xq-transition">
              <svg class="w-6 h-6 xq-accent" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold">GitHub</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">Open source projects</p>
            </div>
          </a>

          <a
            href={GLOBAL.social.peerlist}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center p-4 border xq-border rounded-lg xq-transition hover:shadow-lg group"
          >
            <div class="w-12 h-12 rounded-lg bg-green-500/10 flex items-center justify-center mr-4 group-hover:bg-green-500/20 xq-transition">
              <svg class="w-6 h-6 xq-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold">Peerlist</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">Professional community</p>
            </div>
          </a>
        </div>
      </div>

      <div class="space-y-6">
        <div>
          <h2 class="text-xl md:text-2xl font-semibold mb-4">Currently</h2>
          <div class="space-y-4">
            <div class="p-4 border xq-border rounded-lg bg-blue-50/50 dark:bg-blue-900/10">
              <div class="flex items-center mb-2">
                <div class="w-3 h-3 bg-blue-500 rounded-full mr-3"></div>
                <span class="font-medium text-blue-700 dark:text-blue-300">Currently employed</span>
              </div>
              <p class="text-sm text-gray-600 dark:text-gray-400 ml-6">
                Happy in my current role, but always open to interesting conversations about technology and development
              </p>
            </div>

            <div class="p-4 border xq-border rounded-lg">
              <h4 class="font-medium mb-2">Preferred Communication</h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                Email works best for detailed discussions. For quick questions or networking,
                LinkedIn is ideal. Check out my latest work on GitHub.
              </p>
            </div>
          </div>
        </div>

        <div class="p-6 border xq-border rounded-lg bg-gradient-to-r from-blue-50/50 to-purple-50/50 dark:from-blue-900/10 dark:to-purple-900/10">
          <h3 class="text-lg font-semibold mb-3 xq-accent">Let's Connect & Share Ideas</h3>
          <p class="text-base leading-relaxed text-gray-600 dark:text-gray-400 mb-4">
            Whether you want to discuss technology trends, share development insights,
            or just have a chat about best practices and innovations, I'd love to hear from you.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
